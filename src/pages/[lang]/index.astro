---
import { statSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { education } from '../../content/education';
import { experience } from '../../content/experience';
import { languages } from '../../content/languages';
import { projects } from '../../content/projects';
import { site } from '../../content/site';
import { skills } from '../../content/skills';
import type { LocalePath, PortfolioViewModel } from '../../content/types';
import { isSet } from '../../content/utils';
import { formatMessage, getTranslations, htmlLangByLocale } from '../../i18n/utils';
import { url } from '../../utils/url';

export function getStaticPaths() {
  return (['en', 'fr', 'zh'] as const).map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: LocalePath };
const t = getTranslations(locale);
const htmlLang = htmlLangByLocale[locale];
const localeNames = t.languageSwitcher.names as Record<LocalePath, string>;
const educationRecords = t.education.records as Record<string, string>;
const experienceDescriptions = t.experience.descriptions as Record<string, string>;
const projectTitles = t.researchProjects.records as Record<string, string>;
const projectDescriptions = t.researchProjects.descriptions as Record<string, string>;
const languageNames = t.languages.names as Record<string, string>;

const safeAssetUrl = (candidate: string | undefined, allowedExtensions?: readonly string[]): string | undefined => {
  if (!candidate || !isSet(candidate)) return undefined;
  const relative = candidate.replace(/^public[\\/]/i, '').replace(/^[/\\]+/, '');
  if (relative.split(/[\\/]/).includes('..')) return undefined;
  const publicRoot = path.resolve(process.cwd(), 'public');
  const absolute = path.resolve(publicRoot, relative);
  if (!absolute.startsWith(`${publicRoot}${path.sep}`)) return undefined;
  try {
    if (!statSync(absolute).isFile()) return undefined;
  } catch {
    return undefined;
  }
  if (allowedExtensions && !allowedExtensions.includes(path.extname(absolute).toLowerCase())) return undefined;
  return relative.replaceAll('\\', '/');
};

const safeExternalUrl = (candidate: string | undefined): string | undefined =>
  candidate && /^https:\/\//i.test(candidate) ? candidate : undefined;

const email = isSet(site.contact.email) && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(site.contact.email)
  ? site.contact.email
  : undefined;
const cvCandidate =
  (site.cv.localeOverrides as Partial<Record<LocalePath, string>>)[locale] || site.cv.path;
const cvPath = safeAssetUrl(cvCandidate, ['.pdf']);
const portraitPath = safeAssetUrl(site.portrait, ['.avif', '.jpg', '.jpeg', '.png', '.webp']);
const githubUrl = safeExternalUrl(site.socials.github);
const wechatUrl = safeExternalUrl(site.contact.wechat.url);
const viewModel: PortfolioViewModel = {
  profile: {
    name: site.name,
    chineseName: isSet(site.chineseName) ? site.chineseName : undefined,
    field: t.hero.field,
    portrait: portraitPath ? url(portraitPath) : undefined,
  },
  education: education.map((record) => ({
    id: record.id,
    institution: record.institution,
    qualification: educationRecords[record.id],
    program: record.program || undefined,
  })),
  experience: experience.map((record) => ({
    ...record,
    description: experienceDescriptions[record.id],
  })),
  projects: projects
    .filter((record) => record.published)
    .map((record) => ({
      id: record.id,
      title: projectTitles[record.id] || record.title,
      kind: record.kind,
      description: projectDescriptions[record.id],
    })),
  skills: skills.map((skill) => skill.name),
  languages: languages.map((language) => ({
    name: languageNames[language.id] || language.name,
    level: 'level' in language && isSet(language.level) ? language.level : undefined,
  })),
  contact: {
    email,
    wechatId: isSet(site.contact.wechat.id) ? site.contact.wechat.id : undefined,
    wechatUrl,
    githubUrl,
    cvPath,
  },
};

const visibleSections = [
  { id: 'about', label: t.navigation.about },
  ...(viewModel.education.length ? [{ id: 'education', label: t.navigation.education }] : []),
  ...(viewModel.experience.length ? [{ id: 'internships', label: t.navigation.internships }] : []),
  ...(viewModel.projects.length ? [{ id: 'research-projects', label: t.navigation.researchProjects }] : []),
  ...(viewModel.skills.length ? [{ id: 'skills-interests', label: t.navigation.skillsInterests }] : []),
  ...(viewModel.languages.length ? [{ id: 'languages', label: t.navigation.languages }] : []),
  ...(email ? [{ id: 'contact', label: t.navigation.contact }] : []),
];

const formatDate = (value: string) => {
  const date = new Date(`${value}T00:00:00Z`);
  return new Intl.DateTimeFormat(htmlLang, { month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date);
};
const year = new Date().getUTCFullYear();
const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.field,
    email: email ? `mailto:${email}` : undefined,
    image: portraitPath && Astro.site ? new URL(url(portraitPath), Astro.site).href : undefined,
    sameAs: githubUrl ? [githubUrl] : undefined,
  },
};
---

<BaseLayout
  locale={locale}
  lang={htmlLang}
  title={t.meta.title}
  siteName={site.name}
  description={t.meta.description}
>
  <SiteHeader
    locale={locale}
    homeLabel={t.header.homeLink}
    skipLabel={t.accessibility.skipToContent}
    navLabel={t.accessibility.primaryNavigation}
    menuLabel={t.header.openMenu}
    closeMenuLabel={t.header.closeMenu}
    languageLabel={t.languageSwitcher.label}
    languageNames={localeNames}
    name={site.name}
    sections={visibleSections}
    themeLabel={t.accessibility.themeToggle}
    lightThemeLabel={t.theme.lightLabel}
    darkThemeLabel={t.theme.darkLabel}
  />

  <main id="main-content" class="page-shell">
    <!--
      THESIS: A layered paper-cut atlas of Bassim's work; reject the anonymous CV stack.
      OWN-WORLD: Warm paper, indigo, terracotta, and gold; Fraunces, Instrument Sans, IBM Plex Mono; khatam cuts and an arch portrait frame.
      STORY: Readers take the highlights route or follow one shared path through education, internships, projects, and verified contact.
      FIRST VIEWPORT: Name and field lead at left; an arch portrait slot balances them at right; two route actions sit beneath the introduction.
      FORM: Brief-pinned Moroccan-modern layered paper-cut atlas; seeded direction 5, seed 1935f7ed; paired with the portfolio highlights/full-story staging.
    -->
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
    <section class="hero-section" id="top" aria-labelledby="page-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-location"><span aria-hidden="true">✦</span> {t.hero.location}</p>
          <h1 id="page-title">{t.hero.title}</h1>
          {viewModel.profile.chineseName && <p class="chinese-name">{viewModel.profile.chineseName}</p>}
          <p class="hero-field">{viewModel.profile.field}</p>
          <p class="hero-summary">{t.hero.summary}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#research-projects">
              {t.hero.highlightsAction}<span aria-hidden="true"> ↗</span>
            </a>
            <a class="button button-secondary" href="#education">
              {t.hero.fullStoryAction}<span aria-hidden="true"> ↓</span>
            </a>
          </div>
        </div>
        <div class="hero-art">
          <svg class="hero-orbit" viewBox="0 0 360 360" aria-hidden="true">
            <circle cx="180" cy="180" r="151" fill="none" stroke="currentColor" stroke-dasharray="1 9" />
            <path d="M180 20 195 63l46-16-16 46 43 15-43 15 16 46-46-16-15 43-15-43-46 16 16-46-43-15 43-15-16-46 46 16z" fill="currentColor" />
            <circle cx="180" cy="180" r="75" fill="none" stroke="currentColor" />
          </svg>
          <div class="portrait-frame">
            {viewModel.profile.portrait ? (
              <img src={viewModel.profile.portrait} alt={t.contact.portraitLabel} fetchpriority="high" />
            ) : (
              <div class="portrait-placeholder" role="img" aria-label={t.hero.portraitNote}>
                <svg viewBox="0 0 100 100" aria-hidden="true">
                  <path d="M50 4 57 25l22-8-8 22 21 7-21 7 8 22-22-8-7 21-7-21-22 8 8-22-21-7 21-7-8-22 22 8z" />
                </svg>
                <span>{t.hero.portraitNote}</span>
              </div>
            )}
          </div>
          <p class="art-caption">{viewModel.profile.name}<span aria-hidden="true"> · </span>{viewModel.profile.field}</p>
        </div>
      </div>
      <div class="hero-foot">
        <span class="hero-foot-label">{t.hero.highlightsAction}</span>
        <span class="hero-route-line" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="hero-foot-label">{t.hero.fullStoryAction}</span>
        {cvPath && <a class="hero-cv-link" href={url(cvPath)} download>{t.hero.cvAction}<span aria-hidden="true"> ↓</span></a>}
      </div>
    </section>

    <section class="content-section about-section" id="about" aria-labelledby="about-heading">
      <SectionHeading id="about-heading" title={t.about.title} />
      <div class="about-copy">
        <p>{t.about.paragraphs.background}</p>
        <p>{t.about.paragraphs.experience}</p>
        <p>{t.about.paragraphs.researchDirection}</p>
      </div>
    </section>

    {viewModel.education.length > 0 && (
      <section class="content-section education-section" id="education" aria-labelledby="education-heading">
        <SectionHeading id="education-heading" title={t.education.title} />
        <div class="education-ledger">
          {viewModel.education.map((record, index) => (
            <article class="education-entry">
              <span class="entry-star" aria-hidden="true">✦</span>
              <span class="entry-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{record.qualification}</h3>
                <p>{record.institution}</p>
                {record.program && <span class="mono-label">{record.program}</span>}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {viewModel.experience.length > 0 && (
      <section class="content-section experience-section" id="internships" aria-labelledby="internships-heading">
        <SectionHeading id="internships-heading" title={t.experience.title} />
        <div class="experience-ledger">
          {viewModel.experience.map((record) => (
            <article class="experience-entry">
              <div class="experience-date">
                <time datetime={record.startDate}>{formatDate(record.startDate)}</time>
                <span aria-hidden="true">—</span>
                <time datetime={record.endDate}>{formatDate(record.endDate)}</time>
              </div>
              <div>
                <p class="record-label">{t.experience.recordLabel}</p>
                <h3>{record.organization}</h3>
                <p>{record.description}</p>
              </div>
              <span class="entry-star" aria-hidden="true">✦</span>
            </article>
          ))}
        </div>
      </section>
    )}

    {viewModel.projects.length > 0 && (
      <section class="content-section projects-section" id="research-projects" aria-labelledby="projects-heading">
        <SectionHeading id="projects-heading" title={t.researchProjects.title} />
        <div class="project-ledger">
          {viewModel.projects.map((project) => (
            <article class:list={['project-entry', { 'project-capstone': project.kind === 'capstone' }]}>
              <span class="project-kind">{project.kind === 'capstone' ? t.researchProjects.capstoneLabel : t.researchProjects.projectLabel}</span>
              <h3>{project.title}</h3>
              {project.description && <p>{project.description}</p>}
            </article>
          ))}
        </div>
      </section>
    )}

    {viewModel.skills.length > 0 && (
      <section class="content-section skills-section" id="skills-interests" aria-labelledby="skills-heading">
        <SectionHeading id="skills-heading" title={t.skillsInterests.title} />
        <p class="skills-intro">{t.skillsInterests.skillsLabel}</p>
        <ul class="skill-list">
          {viewModel.skills.map((skill) => <li>{skill}<span aria-hidden="true">✦</span></li>)}
        </ul>
      </section>
    )}

    {viewModel.languages.length > 0 && (
      <section class="content-section languages-section" id="languages" aria-labelledby="languages-heading">
        <SectionHeading id="languages-heading" title={t.languages.title} />
        <ul class="language-list">
          {viewModel.languages.map((language) => (
            <li><span>{language.name}</span>{language.level && <span class="mono-label">{language.level}</span>}</li>
          ))}
        </ul>
      </section>
    )}

    {email && (
      <section class="content-section contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="contact-panel">
          <div>
            <SectionHeading id="contact-heading" title={t.contact.title} />
            <p class="section-intro">{t.contact.introduction}</p>
          </div>
          <div class="contact-links">
            <a class="contact-link contact-link-primary" href={`mailto:${email}`}>
              <span>{t.contact.emailLabel}</span><strong>{email}</strong><span aria-hidden="true">↗</span>
            </a>
            {githubUrl && (
              <a class="contact-link" href={githubUrl} target="_blank" rel="noopener noreferrer">
                <span>{t.contact.githubLabel}</span><strong>{githubUrl.replace(/^https:\/\/(www\.)?/, '')}</strong>
                <span class="visually-hidden"> ({t.contact.externalLink})</span><span aria-hidden="true">↗</span>
              </a>
            )}
            {wechatUrl && (
              <a class="contact-link" href={wechatUrl} target="_blank" rel="noopener noreferrer">
                <span>{t.contact.wechatLabel}</span><strong>{viewModel.contact.wechatId || t.contact.wechatLabel}</strong>
                <span class="visually-hidden"> ({t.contact.externalLink})</span><span aria-hidden="true">↗</span>
              </a>
            )}
            {viewModel.contact.wechatId && !wechatUrl && (
              <p class="contact-link contact-link-static"><span>{t.contact.wechatIdLabel}</span><strong>{viewModel.contact.wechatId}</strong></p>
            )}
            {cvPath && (
              <a class="contact-link" href={url(cvPath)} download>
                <span>{t.contact.cvLabel}</span><strong>{t.hero.cvAction}</strong><span aria-hidden="true">↓</span>
              </a>
            )}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p><span class="footer-star" aria-hidden="true">✦</span> {formatMessage(t.footer.copyright, { year })}</p>
      <a href="#top">{t.footer.backToTop}<span aria-hidden="true"> ↑</span></a>
    </div>
  </footer>
</BaseLayout>
